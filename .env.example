# APEN Support local server settings

# ── Voltron AI chat proxy (proxy/voltron-proxy.mjs) ──
# Point this at ANY OpenAI-compatible LLM server (e.g. your own). VOLTRON_API_URLS
# is the primary setting: a whitespace/comma/semicolon-separated list of upstream
# endpoints the proxy tries in order, failing over only on HTTP 429 or 5xx. For a
# single server, just put one URL. VOLTRON_API_URL (singular) is a legacy
# single-endpoint fallback, used only when VOLTRON_API_URLS is empty. End the URL
# at /v1 — the proxy appends /chat/completions automatically.
# TLS to a public CA (Let's Encrypt) validates against the system trust store out
# of the box; no NODE_EXTRA_CA_CERTS needed.
VOLTRON_PROXY_HOST=127.0.0.1
VOLTRON_PROXY_PORT=8787
VOLTRON_API_URLS=                      # e.g. https://llm.yourdomain.com/v1   (space-separate to add fallbacks)
VOLTRON_API_URL=                       # legacy single-endpoint fallback (used only if VOLTRON_API_URLS is empty)
VOLTRON_API_KEY=                       # Bearer token for your LLM (blank = no Authorization header sent)
VOLTRON_MODEL=voltron-v3               # model name your server expects
VOLTRON_MAX_TOKENS=1000                # clamped 1–2000

# Site stats, feedback, service health, and live announcements API
STATS_HOST=127.0.0.1
STATS_PORT=8788
NGINX_ACCESS_LOG=/var/log/nginx/cui_nginx_access.log

# Optional admin notification email target persisted by /api/notification-settings.
NOTIFICATION_EMAIL_TO=

# Semicolon-separated upload roots scanned by /api/live-announcements.
# Format: Label|Category|filesystem path|public URL prefix
LIVE_ANNOUNCEMENT_PATHS=Site Uploads|Site Update|/var/www/html/uploads|/uploads/;Static Export Uploads|Site Update|/var/www/apen_support_nextjs/out/uploads|/uploads/;PDQ Repository|Software|/var/www/html/PDQ/Repository|/PDQ/Repository/;Evaluate-STIG Documents|Security|/var/www/html/evaluate-stig/doc|/evaluate-stig/doc/;PIP Repository|Software|/var/www/html/repos/piprepo|/repos/piprepo/;Logos|Site Update|/var/www/html/logos|/logos/
LIVE_ANNOUNCEMENT_CACHE_SECONDS=10
LIVE_ANNOUNCEMENT_MAX_ITEMS=30
LIVE_ANNOUNCEMENT_MAX_DEPTH=8
LIVE_ANNOUNCEMENT_MAX_FILES_SCANNED=5000
LIVE_ANNOUNCEMENT_MAX_LABELS=3
# NOTE: admins can also manage the scan roots from the dashboard (Monitoring
# tab → Live Announcement Scan Roots). When proxy/announcement-paths.json
# exists it overrides LIVE_ANNOUNCEMENT_PATHS.

# Package-mirror "last updated" stamps served at /api/repo-freshness and shown
# on the /docs/repos pages. Defaults cover the rpm/deb/pip/cran mirrors — only
# set REPO_FRESHNESS_PATHS to override. Format: id|Label|filesystem path|public URL prefix
#REPO_FRESHNESS_PATHS=rpm|RPM Mirror (Enterprise Linux)|/var/www/html/repos/rpm|/repos/rpm/
REPO_FRESHNESS_CACHE_SECONDS=1800
REPO_FRESHNESS_MAX_DEPTH=4
REPO_FRESHNESS_MAX_DIRS=3000

# Infrastructure-node probe interval in milliseconds. Floor is 10 000.
# Drives how often the proxy pings every entry in infrastructure-nodes.json.
NODE_POLL_INTERVAL_MS=30000

# Admin content-management API token. Required by /api/admin/* routes
# (content overrides + custom-page wizard + infrastructure node CRUD).
# Leave blank ONLY when ADMIN_AUTH_DISABLED=1 (local dev). In production,
# set a strong random value (`openssl rand -hex 24`) and share it with
# admins via a secrets manager — admins paste it once into the Admin
# Console "Unlock editor" dialog and the browser caches it locally.
ADMIN_API_TOKEN=

# Set to 1 to allow the admin API to run with NO authentication. Only
# safe in local development. The proxy logs a loud warning at startup
# when this flag is on. Leave unset / 0 in any non-laptop environment.
ADMIN_AUTH_DISABLED=

# Directory for images uploaded through POST /api/admin/logo-upload. Leave
# blank for the platform default:
#   Windows/dev: <project>/public/logos/no_backgrounds/admin
#   Linux/prod:  /var/www/html/logos/no_backgrounds/admin
# The proxy service account must be able to create and write this directory.
# nginx serves the Linux default through the existing /logos/ legacy fallback.
ADMIN_LOGO_UPLOAD_DIR=

# ── External-URL redirector ──
# Internal/private destination URLs that must NOT appear in the public
# static bundle. The client links to /api/external/<key>; this proxy
# 302-redirects to whatever you set below. Leave any entry blank to
# disable that key (the proxy returns 404 for unconfigured keys).
EXTERNAL_URL_CERTIFICATE_SERVICES=
EXTERNAL_URL_TRACK_IT=
EXTERNAL_URL_TENABLE=
EXTERNAL_URL_VOLTRON=

# ── Cert Request Wizard backend (CES/CEP scaffolding) ──
# Optional. When set, the wizard surfaces an "Submit via API" path in
# addition to the existing /certsrv portal iframe. Until all required
# values are set, /api/cert-request/* (except /status) returns 503 and
# the wizard renders only the portal path.
#
# AuthType must be one of: kerberos, username, certificate.
# Kerberos additionally requires CERT_REQUEST_KEYTAB and
# CERT_REQUEST_SERVICE_SPN for protocol transition from Linux.
#
# Implementation TODO is in proxy/cert-request.mjs.
CERT_REQUEST_CEP_URL=                  # e.g. https://apenblcsecuica1.blcse.mil/ADPolicyProvider_CEP_Kerberos/service.svc/CEP
CERT_REQUEST_CES_URL=                  # e.g. https://apenblcsecuica1.blcse.mil/APENBLCSECUICA1-RootCA-Issuing_CES_Kerberos/service.svc/CES
CERT_REQUEST_CA_CONFIG=                # e.g. apenblcsecuica1.blcse.mil\APENBLCSECUICA1-RootCA-Issuing
CERT_REQUEST_AUTH_TYPE=                # kerberos | username | certificate
CERT_REQUEST_ALLOWED_TEMPLATES=        # comma-separated allow-list, e.g. WebServer,WorkstationAuthentication
CERT_REQUEST_KEYTAB=                   # /etc/krb5.keytab — Kerberos only
CERT_REQUEST_SERVICE_SPN=              # HTTP/apensupport.blcse.mil — Kerberos only
CERT_REQUEST_TIMEOUT_MS=15000

# ── Site-wide + admin LDAP login (real per-user auth via AD) ──
# ONE key drives this: LDAP_REALMS, a JSON array of realm configs. The former
# LDAP_URL / LDAP_BIND_USER_DN_TEMPLATE / LDAP_ADMIN_GROUP_DN / LDAP_BASE_DN /
# LDAP_CA_CERT_PATH / ADMIN_SESSION_COOKIE_NAME keys are GONE — no code reads
# them, and setting them leaves login dead with LDAP_CONFIGURED=false.
#
# Several enclaves can share the same AD domain NAME while using unrelated
# Domain Controllers, so each realm pins its own DC. `url` may be a single URL
# or an array of them (tried in order, failing over only on connection errors,
# never on a wrong password). Pin an IP rather than a bare domain name; when
# you do, add "servername" so TLS verifies against the DC's certificate
# hostname: {"url":"ldaps://10.0.1.5:636","servername":"dc1.blcse.mil"}.
#
# A successful bind grants a 'general' session (site-wide browsing).
# Membership of that realm's adminGroupDn additionally grants 'admin'.
# Omit adminGroupDn for a realm that must never grant admin.
# Empty/unset => /api/auth/* returns 503 and admin falls back to the legacy
# ADMIN_API_TOKEN paste flow.
#
# LDAP_REALMS=[{"id":"blcse-primary","label":"BLCSE (Primary)","url":["ldaps://DC1_IP:636","ldaps://DC2_IP:636"],"bindUserDnTemplate":"{username}@example.mil","baseDn":"DC=example,DC=mil","adminGroupDn":"CN=APEN Admins,OU=Groups,DC=example,DC=mil","allowedDomains":["example.mil"],"caCertPath":"/etc/apen/certs/ad-root-ca.pem"}]
LDAP_REALMS=
LDAP_TIMEOUT_MS=5000
ADMIN_SESSION_TTL_HOURS=8
# Cookie name for BOTH general and admin sessions (renamed from
# ADMIN_SESSION_COOKIE_NAME when general logins were added).
SESSION_COOKIE_NAME=apen_session

# ── Local development helpers ──
# Next.js dev server cross-origin allow-list (HMR / _next resources) for when you
# browse the dev server from another device on your LAN. Comma-separated IPs.
# localhost always works regardless; safe to leave at the default.
DEV_ALLOWED_ORIGINS=192.168.1.150

# Helpdesk ticket-status lookup (app/support/status). Blank = that page's live
# lookup is disabled; the rest of the site is unaffected.
HELPDESK_API_TOKEN=

# ── Advanced proxy toggles (optional; defaults shown) ──
# Set to 0 to stop the New Page Wizard from writing page.tsx source files on publish.
GENERATE_CUSTOM_PAGE_SOURCES=1
# Set to 0 to skip `npm run build` when an admin hits Publish (the snapshot is still written).
PUBLISH_BUILD=1
# How often the proxy probes each infrastructure node, in ms (floor 10000).
NODE_POLL_INTERVAL_MS=30000

# Used only by scripts/extract-repo-guides.mjs (one-off content migration helper).
OLD_REPOS_ROOT=/var/www/html/repos
REPO_HOST=https://apensupport.blcse.mil


# ── Added: keys the code reads that this file used to omit ──────────────
# Public origin of THIS site. Seeds infrastructure-node probe targets and any
# self-referencing URL. Probe by FQDN, never by IP — a bare-IP request sends
# Host: <ip>, which nginx may match to a completely different server block.
SITE_ORIGIN=https://apensupport.blcse.mil

# /api/external/<key> redirector destinations. The client links to the
# redirector so internal addresses never enter the static bundle; an unset key
# 404s that tile. Keys: certificate-services, track-it, tenable, voltron (above)
# plus the five below, linked from lib/data/constants.ts and config/links.ts.
EXTERNAL_URL_WAN_SHOW=
EXTERNAL_URL_QPRO=
EXTERNAL_URL_HPC=
EXTERNAL_URL_HUB=
EXTERNAL_URL_CUI_PORTAL=

# /admin#nginx managed zones/upstreams editor. MUST be the directory that
# server.conf includes its fragments from, or Publish writes into nowhere.
NGINX_MANAGED_CONF_DIR=/etc/nginx/conf.d/apen_support
NGINX_MANAGED_RELOAD=1
NGINX_BIN=/usr/sbin/nginx
SYSTEMCTL_BIN=/usr/bin/systemctl

# /admin#nginx live status. VTS first, stub_status as the fallback; both are
# loopback URLs served by nginx itself.
NGINX_VTS_JSON_URL=http://127.0.0.1:8099/status/format/json
NGINX_STUB_STATUS_URL=http://127.0.0.1:8099/stub_status
NGINX_VTS_ZONE_FILTER_GROUP=
NGINX_STATUS_CACHE_MS=4000
NGINX_STATUS_TIMEOUT_MS=2500

# Product-file library browsed by the admin file manager.
DOWNLOAD_LIBRARY_ROOT=
DOWNLOAD_LIBRARY_REGISTRY=

# How often every infrastructure node is probed (ms, floor 10000).
NODE_POLL_INTERVAL_MS=30000
