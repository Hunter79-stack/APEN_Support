# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Environment variables (secrets)
.env.local
.env.*.local
.env.production

# OS files
.DS_Store
Thumbs.db

# Editor directories
.idea/
.vscode/
*.swp
*.swo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo

# Vercel
.vercel

# Proxy runtime state — these files are written by proxy/site-stats.mjs at
# runtime (admin overrides, custom pages saved by the wizard, infrastructure-
# node CRUD output, queued admin notifications, system-event audit log,
# acknowledged-alert dedup tracking, and the user-feedback inbox). They
# contain per-deployment state and PII (feedback authors, IP addresses)
# that should NEVER be checked in. Keep proxy/infrastructure-nodes.json
# tracked only if you want a default node list — otherwise add it here too.
proxy/feedback-history.json
proxy/notification-settings.json
proxy/notification-outbox.json
proxy/acknowledged-alerts.json
proxy/content-overrides.json
proxy/custom-pages.json
proxy/content-audit.json
proxy/infrastructure-nodes.json
proxy/admin-sessions.json
proxy/announcement-paths.json
# Added: these four were written at runtime but neither tracked nor ignored,
# so a single `git add -A` would have committed chat transcripts, usernames,
# source IPs and live session tokens. This list is also what the offline
# bundle strips, so an omission here leaks into the mirror too.
proxy/chat-history.json
proxy/auth-events.json
proxy/general-sessions.json
proxy/dismissed-alerts.json
proxy/assistant-prompts.json
proxy/file-library-dirs.json
proxy/nginx-managed.json
proxy/selfheal-log.json

# Speedtest runtime logs (written by the apen-speedtest PM2 app)
speedtest/logs/
speedtest/**/__pycache__/

# Local cleanup notes (generated by automated audits). Safe to delete after
# you've worked through the file's TODO list.
CLEANUP-DELETE-THESE.txt

# Provenance hardening (2026-09-03): never commit these.
# .env.local.bak-* carries the same live credentials as .env.local
.env.local.*
# editor permission logs with internal IPs/usernames
.claude/
# install-hardening-upgrade.sh snapshots
.apen-backups/
# stray apt-mirror nohup log at the repo root
/sudo
