# ─────────────────────────────────────────────────────────────────────────────
# enclave.env — the ONLY file you edit per enclave.
#
# Copy to enclave.env next to INSTALL.sh, fill it in, run ./INSTALL.sh.
# INSTALL.sh refuses to run while any REQUIRED value is still CHANGE_ME.
#
# Everything the two enclaves share (AD realm names, usernames, the site FQDN,
# nginx behaviour, rate limits, page content) is already baked into the bundle.
# Only what genuinely differs lives here.
#
# QUOTING: this file is sourced by bash. Any value containing a space, a pipe,
# a brace, a quote or a '#' MUST be quoted, or the shell tries to run part of
# it. Use SINGLE quotes for the LDAP_REALMS JSON so its double quotes survive.
# The templates below are already quoted correctly — keep the quotes.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site identity ────────────────────────────────────────────────────────────
# Same FQDN in both enclaves, so this normally needs no change. If it ever
# differs, change it here and nowhere else: it drives server_name, the TLS cert
# filenames, SITE_ORIGIN, and every infrastructure-node probe target.
SITE_FQDN=apensupport.blcse.mil
SITE_ALT_FQDN=apensupport2.blcse.mil

# TLS material for the vhost. Paths as they exist ON THE ENCLAVE HOST.
TLS_CERT_PATH=/etc/nginx/ssl/apensupport-multi.crt
TLS_KEY_PATH=/etc/nginx/ssl/apensupport-multi.key

# ── Voltron (DIFFERENT IP in this enclave) ───────────────────────────────────
# The on-prem LLM gateway. VOLTRON_UI_URL is the browsable portal — it becomes
# the click-through link and the "Voltron LLM Upstream" monitor node.
VOLTRON_UI_URL="CHANGE_ME"                 # e.g. https://voltron.example.mil/  or  https://10.20.30.40/
# Failover list of OpenAI-compatible API bases, tried in order. Space/comma
# separated. Each entry may carry its own model as url|model.
VOLTRON_API_URLS="CHANGE_ME"               # e.g. https://voltron.example.mil/api|voltron-v3
VOLTRON_API_KEY="CHANGE_ME"                # Open WebUI API key on THIS enclave
VOLTRON_MODEL=voltron-v3
VOLTRON_MAX_TOKENS=2000
VOLTRON_TIMEOUT_MS=60000                    # per-upstream deadline; a hung upstream fails over after this

# ── Admin workstations (DIFFERENT names and IPs in this enclave) ─────────────
# One entry per line inside the quotes: "<ip> <HOSTNAME> <ad-username>".
# All three fields matter. The IP drives the nginx allowlist; the hostname and
# username are parsed out of the generated comment to attribute entries in the
# admin audit log, so a wrong name silently mislabels the audit trail.
# 127.0.0.1 is always added — do not list it here.
ADMIN_WORKSTATIONS="
CHANGE_ME 10.0.0.10 WORKSTATION01 firstuser.ou
CHANGE_ME 10.0.0.11 WORKSTATION02 seconduser.ou
"

# ── Active Directory (SAME realm and usernames, DIFFERENT DC addresses) ──────
# One JSON array, single line. Pin each DC by IP and give "servername" so TLS
# verifies against the DC certificate's hostname rather than the IP.
# Membership of adminGroupDn grants an admin session; a plain successful bind
# grants an ordinary browsing session.
LDAP_REALMS='CHANGE_ME'
# Example (single line, no newlines):
# LDAP_REALMS='[{"id":"blcse-primary","label":"BLCSE","url":[{"url":"ldaps://10.0.0.5:636","servername":"dc1.blcse.mil"},{"url":"ldaps://10.0.0.6:636","servername":"dc2.blcse.mil"}],"bindUserDnTemplate":"{username}@blcse.mil","baseDn":"DC=blcse,DC=mil","adminGroupDn":"CN=APEN Admins,OU=Groups,DC=blcse,DC=mil","allowedDomains":["blcse.mil"],"caCertPath":"/etc/apen/certs/ad-root-ca.pem"}]'

# ── Secrets — generate FRESH on this enclave, never copy from the other one ──
# Leave as GENERATE and INSTALL.sh mints one with `openssl rand -hex 24`,
# writes it to .env.local, and syncs it into the nginx admin-token include.
ADMIN_API_TOKEN=GENERATE

# ── Backend services on this enclave ─────────────────────────────────────────
# NetDiag agent nginx proxies /netdiag/ to. Use 127.0.0.1:8085 when the
# FastAPI container is co-located (the usual case); a host:port when a remote
# agent does the probing.
NETDIAG_UPSTREAM=127.0.0.1:8085
# Internal WinGet REST source. Blank disables the /winget/ proxy locations and
# drops the WinGet monitor node.
WINGET_REPO_HOST="CHANGE_ME"               # e.g. apenwingetrepo.blcse.mil

# ── /api/external/<key> redirector destinations ──────────────────────────────
# The site links to /api/external/<key> so these addresses never enter the
# static bundle. A blank value makes that tile 404 — blank out what this
# enclave does not have rather than pointing it at the other enclave.
EXTERNAL_URL_CERTIFICATE_SERVICES=
EXTERNAL_URL_TRACK_IT=
EXTERNAL_URL_TENABLE=
EXTERNAL_URL_VOLTRON=
EXTERNAL_URL_WAN_SHOW=
EXTERNAL_URL_QPRO=
EXTERNAL_URL_HPC=
EXTERNAL_URL_HUB=
EXTERNAL_URL_CUI_PORTAL=

# ── Host paths (identical on both hosts per the transfer plan) ───────────────
SITE_ROOT=/var/www/apen_support_nextjs
LEGACY_WEBROOT=/var/www/html
NGINX_ACCESS_LOG=/var/log/nginx/access.log
# Set to 0 on a serve-only mirror with no toolchain: the admin Publish button
# then writes content JSON without spawning `npm run build`.
PUBLISH_BUILD=1
